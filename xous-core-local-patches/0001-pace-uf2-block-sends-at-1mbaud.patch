 RETRY_LIMIT = 5  # Maximum failed blocks before quitting
 RESPONSE_TIMEOUT = 0.5  # 500ms timeout for device response
 
+# LOCAL PATCH, not upstream (sources/xous-core is a gitignored, separately
+# tracked checkout of betrusted-io/xous-core -- see baochip-1x-experiments
+# docs/04-bringup-log.md, 2026-08-20). The single unpaced ser.write() below
+# used to send each block reliably drops characters at 1000000 baud with no
+# flow control -- confirmed on hardware the same day, same symptom this
+# file's own 'localecho off' preamble already works around a few lines down
+# ("we need to slow down the protocol... due to lag in processing local
+# echo"). That fix was never carried over to the block-transfer path itself.
+#
+# Sends always go one character at a time now -- never one bulk write of the
+# whole block. CHAR_SEND_DELAY is an *extra* sleep on top of that, and 0 does
+# NOT mean "send it all at once": calibration on hardware the same day found
+# the per-write()/flush() syscall and USB round-trip overhead alone (no
+# explicit sleep, ~170us/char measured against a realistic ~683-char block)
+# is already reliable -- 15/15 clean trials, vs. every chunked-write strategy
+# tried (8/16/32/64 bytes per write) failing 0/8 regardless of inter-chunk
+# delay. The receiver apparently cannot absorb *any* burst bigger than one
+# byte, only a per-byte one. An explicit 5ms/char, the first fix applied, was
+# correct but ~30x slower than necessary -- it would have made an
+# 11584-block kernel transfer take ~11 hours instead of ~20 minutes. Only
+# raise this if a specific link proves less reliable than this one.
+CHAR_SEND_DELAY = 0.0
+
+
+def _paced_write(ser: serial.Serial, s: str, delay: float = CHAR_SEND_DELAY) -> None:
+    for ch in s:
+        ser.write(ch.encode('utf-8'))
+        ser.flush()
+        if delay > 0:
+            time.sleep(delay)
+
 
