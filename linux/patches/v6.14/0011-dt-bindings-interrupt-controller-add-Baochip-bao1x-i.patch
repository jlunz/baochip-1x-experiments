From a4b4185ad676cf531be61d311da09ffedfded103 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 15 Jul 2026 11:14:44 +0200
Subject: [PATCH 11/17] dt-bindings: interrupt-controller: add Baochip bao1x
 interrupt fabric

Add the baochip vendor prefix and bindings for the two levels of the
bao1x interrupt fabric: the CSR-controlled VexRiscv 32-line external
interrupt array (no memory-mapped registers) and the IRQARRAY event
aggregator banks that fan peripheral events onto its lines.

Co-developed-by: Claude <noreply@anthropic.com>
---
 .../baochip,bao1x-intc.yaml                   | 49 +++++++++++++++++
 .../baochip,bao1x-irqarray.yaml               | 53 +++++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +
 3 files changed, 104 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-intc.yaml
 create mode 100644 Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-irqarray.yaml

diff --git a/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-intc.yaml b/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-intc.yaml
new file mode 100644
index 000000000..fc7f8aed1
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-intc.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/baochip,bao1x-intc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Baochip bao1x external interrupt array
+
+description:
+  The VexRiscv core in the Baochip bao1x SoC has no PLIC. External
+  interrupts arrive through a 32-line interrupt array (VexRiscv
+  ExternalInterruptArrayPlugin) that feeds the hart's supervisor external
+  interrupt. The array is controlled entirely through custom CSRs
+  (supervisor mask 0x9C0, supervisor pending 0xDC0), so the controller has
+  no memory-mapped registers.
+
+maintainers:
+  - Julian Lunz <julianlunz+claude@proton.me>
+
+properties:
+  compatible:
+    const: baochip,bao1x-intc
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 1
+    description: The array line number, 0 to 31.
+
+  interrupts-extended:
+    maxItems: 1
+    description: The supervisor external interrupt of the riscv,cpu-intc.
+
+required:
+  - compatible
+  - interrupt-controller
+  - '#interrupt-cells'
+  - interrupts-extended
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller {
+        compatible = "baochip,bao1x-intc";
+        interrupt-controller;
+        #interrupt-cells = <1>;
+        interrupts-extended = <&cpu0_intc 9>;
+    };
diff --git a/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-irqarray.yaml b/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-irqarray.yaml
new file mode 100644
index 000000000..7becd6f01
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/baochip,bao1x-irqarray.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/baochip,bao1x-irqarray.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Baochip bao1x IRQARRAY event aggregator bank
+
+description:
+  LiteX EventManager-style interrupt aggregator on the Baochip bao1x SoC.
+  Each of the 20 banks collects up to 16 peripheral event sources onto one
+  line of the bao1x external interrupt array. Events are latched in
+  EV_PENDING (write-1-to-clear) and gated by EV_ENABLE, so the bank's
+  children are edge interrupts.
+
+maintainers:
+  - Julian Lunz <julianlunz+claude@proton.me>
+
+properties:
+  compatible:
+    const: baochip,bao1x-irqarray
+
+  reg:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 1
+    description: The event slot within the bank, 0 to 15.
+
+  interrupts-extended:
+    maxItems: 1
+    description: The bank's line in the bao1x external interrupt array.
+
+required:
+  - compatible
+  - reg
+  - interrupt-controller
+  - '#interrupt-cells'
+  - interrupts-extended
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller@e0013000 {
+        compatible = "baochip,bao1x-irqarray";
+        reg = <0xe0013000 0x1000>;
+        interrupt-controller;
+        #interrupt-cells = <1>;
+        interrupts-extended = <&bao1x_intc 5>;
+    };
