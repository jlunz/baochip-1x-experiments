From f4e96dd94f2c5ca452e9cf98dc0e90bfebcfe0e2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 15 Jul 2026 15:59:18 +0200
Subject: [PATCH 18/22] dt-bindings: spi: add Baochip bao1x uDMA SPIM

Command-stream SPI master (chip select is part of the stream, four
native selects) whose uDMA channels only reach the on-chip IFRAM, so
each controller gets an IFRAM slice for command/TX/RX bounce buffers
alongside the register block.

Co-developed-by: Claude <noreply@anthropic.com>
---
 .../bindings/spi/baochip,bao1x-udma-spim.yaml | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/spi/baochip,bao1x-udma-spim.yaml

diff --git a/Documentation/devicetree/bindings/spi/baochip,bao1x-udma-spim.yaml b/Documentation/devicetree/bindings/spi/baochip,bao1x-udma-spim.yaml
new file mode 100644
index 000000000..5543fcd46
--- /dev/null
+++ b/Documentation/devicetree/bindings/spi/baochip,bao1x-udma-spim.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/baochip,bao1x-udma-spim.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Baochip bao1x uDMA SPI master
+
+description:
+  PULP-style uDMA SPI master on the Baochip bao1x SoC. The engine
+  executes a 32-bit command stream (chip select assertion is part of the
+  stream) and moves payload through uDMA channels that can only access
+  the on-chip IFRAM banks, so each controller is assigned a private
+  IFRAM slice used as command/TX/RX bounce buffers. Four native chip
+  selects.
+
+maintainers:
+  - Julian Lunz <julianlunz+claude@proton.me>
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+properties:
+  compatible:
+    const: baochip,bao1x-udma-spim
+
+  reg:
+    items:
+      - description: controller registers
+      - description: IFRAM slice for the command/TX/RX bounce buffers
+
+  reg-names:
+    items:
+      - const: regs
+      - const: ifram
+
+  clocks:
+    maxItems: 1
+    description: The peripheral clock (perclk) feeding the SCK divider.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi@50105000 {
+        compatible = "baochip,bao1x-udma-spim";
+        reg = <0x50105000 0x1000>, <0x50012000 0x1000>;
+        reg-names = "regs", "ifram";
+        clocks = <&perclk>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        flash@0 {
+            compatible = "jedec,spi-nor";
+            reg = <0>;
+            spi-max-frequency = <10000000>;
+        };
+    };
