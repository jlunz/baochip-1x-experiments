From cc892d5b65e45ce96ae57ded7ff726fc3a5b86a1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 14 Jul 2026 19:23:13 +0200
Subject: [PATCH 05/10] riscv: mm: skip icache flush for PFNs without a struct
 page

flush_icache_pte() unconditionally does page_folio(pte_page(pte)).
For mappings inserted with vmf_insert_mixed() over memory that has no
memmap coverage - e.g. cramfs XIP mappings pointing directly into
flash - pte_page() returns a bogus struct page pointer and the folio
dereference oopses the kernel as soon as userspace maps an executable
XIP page.

Such PFNs were never written through the dcache, so there is no stale
icache state to flush; return early when pfn_valid() says there is no
struct page to track dcache-clean state in.

Co-developed-by: Claude <noreply@anthropic.com>
---
 arch/riscv/mm/cacheflush.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/mm/cacheflush.c b/arch/riscv/mm/cacheflush.c
index b81672729..27c424eb9 100644
--- a/arch/riscv/mm/cacheflush.c
+++ b/arch/riscv/mm/cacheflush.c
@@ -86,7 +86,18 @@ void flush_icache_mm(struct mm_struct *mm, bool local)
 #ifdef CONFIG_MMU
 void flush_icache_pte(struct mm_struct *mm, pte_t pte)
 {
-	struct folio *folio = page_folio(pte_page(pte));
+	struct folio *folio;
+
+	/*
+	 * PFNs without a struct page (e.g. XIP file mappings pointing
+	 * straight into flash inserted via vmf_insert_mixed()) have no
+	 * PG_dcache_clean tracking; nothing was ever written to them
+	 * through the dcache, so the icache cannot be stale either.
+	 */
+	if (!pfn_valid(pte_pfn(pte)))
+		return;
+
+	folio = page_folio(pte_page(pte));
 
 	if (!test_bit(PG_dcache_clean, &folio->flags)) {
 		flush_icache_mm(mm, false);
-- 
