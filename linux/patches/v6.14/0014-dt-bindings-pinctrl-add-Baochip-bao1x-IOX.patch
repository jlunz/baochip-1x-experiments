From b8bf0f7eacede9354229a23a2ed98debed55fd58 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 15 Jul 2026 11:36:07 +0200
Subject: [PATCH 14/19] dt-bindings: pinctrl: add Baochip bao1x IOX

Pin mux + GPIO controller: six 16-pin ports, four functions per pin
(2-bit selector, function 0 = GPIO), pull-up/schmitt/slew pinconf.
Configuration subnodes use the generic function/groups properties with
one group per pin.

Co-developed-by: Claude <noreply@anthropic.com>
---
 .../bindings/pinctrl/baochip,bao1x-iox.yaml   | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pinctrl/baochip,bao1x-iox.yaml

diff --git a/Documentation/devicetree/bindings/pinctrl/baochip,bao1x-iox.yaml b/Documentation/devicetree/bindings/pinctrl/baochip,bao1x-iox.yaml
new file mode 100644
index 000000000..49b572fd2
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/baochip,bao1x-iox.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/baochip,bao1x-iox.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Baochip bao1x IOX pin controller
+
+description:
+  The IOX block on the Baochip bao1x SoC multiplexes and configures six
+  16-pin ports (PA..PF). Each pin selects one of four functions with a
+  2-bit field (function 0 is GPIO) and has pull-up, schmitt-trigger and
+  slew-rate controls. All 96 pins are also exposed as one GPIO
+  controller. Pin configuration subnodes use the generic "function" and
+  "groups" properties; every pin is its own group ("PA0".."PF15") and the
+  functions are "gpio", "af1", "af2" and "af3".
+
+maintainers:
+  - Julian Lunz <julianlunz+claude@proton.me>
+
+properties:
+  compatible:
+    const: baochip,bao1x-iox
+
+  reg:
+    maxItems: 1
+
+  gpio-controller: true
+
+  '#gpio-cells':
+    const: 2
+
+  gpio-ranges:
+    maxItems: 1
+
+patternProperties:
+  '-pins$':
+    type: object
+    allOf:
+      - $ref: pinmux-node.yaml#
+      - $ref: pincfg-node.yaml#
+    properties:
+      function:
+        enum: [gpio, af1, af2, af3]
+      groups: true
+      bias-pull-up: true
+      bias-disable: true
+      input-schmitt-enable: true
+      slew-rate:
+        enum: [0, 1]
+    required:
+      - function
+      - groups
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - gpio-controller
+  - '#gpio-cells'
+  - gpio-ranges
+
+additionalProperties: false
+
+examples:
+  - |
+    pinctrl@5012f000 {
+        compatible = "baochip,bao1x-iox";
+        reg = <0x5012f000 0x300>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        gpio-ranges = <&iox 0 0 96>;
+
+        uart2-pins {
+            function = "af1";
+            groups = "PB13", "PB14";
+        };
+    };
-- 
