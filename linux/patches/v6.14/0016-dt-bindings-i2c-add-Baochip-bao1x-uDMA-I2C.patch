From 06c4aed733b32e33cf6a84fa2b71d2f1898a99e7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 15 Jul 2026 15:47:08 +0200
Subject: [PATCH 16/17] dt-bindings: i2c: add Baochip bao1x uDMA I2C

Command-stream I2C master whose uDMA channels can only reach the
on-chip IFRAM, so each bus gets an IFRAM slice for its command/TX/RX
bounce buffers alongside the register block. The bit-rate divider is
derived from the perclk clock reference.

Co-developed-by: Claude <noreply@anthropic.com>
---
 .../bindings/i2c/baochip,bao1x-udma-i2c.yaml  | 61 +++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/i2c/baochip,bao1x-udma-i2c.yaml

diff --git a/Documentation/devicetree/bindings/i2c/baochip,bao1x-udma-i2c.yaml b/Documentation/devicetree/bindings/i2c/baochip,bao1x-udma-i2c.yaml
new file mode 100644
index 000000000..47a776757
--- /dev/null
+++ b/Documentation/devicetree/bindings/i2c/baochip,bao1x-udma-i2c.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/baochip,bao1x-udma-i2c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Baochip bao1x uDMA I2C master
+
+description:
+  PULP-style uDMA I2C controller on the Baochip bao1x SoC. The engine
+  executes a 32-bit command stream and moves payload through uDMA
+  channels, all of which can only access the on-chip IFRAM banks, so
+  each bus is assigned a private IFRAM slice used as command/TX/RX
+  bounce buffers.
+
+maintainers:
+  - Julian Lunz <julianlunz+claude@proton.me>
+
+allOf:
+  - $ref: /schemas/i2c/i2c-controller.yaml#
+
+properties:
+  compatible:
+    const: baochip,bao1x-udma-i2c
+
+  reg:
+    items:
+      - description: controller registers
+      - description: IFRAM slice for the command/TX/RX bounce buffers
+
+  reg-names:
+    items:
+      - const: regs
+      - const: ifram
+
+  clocks:
+    maxItems: 1
+    description: The peripheral clock (perclk) feeding the bit-rate divider.
+
+  clock-frequency:
+    default: 100000
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c@50109000 {
+        compatible = "baochip,bao1x-udma-i2c";
+        reg = <0x50109000 0x1000>, <0x50011000 0xc00>;
+        reg-names = "regs", "ifram";
+        clocks = <&perclk>;
+        clock-frequency = <100000>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+    };
-- 
