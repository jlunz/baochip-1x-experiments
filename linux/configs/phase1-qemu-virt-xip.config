# Phase 1: rv32 + XIP_KERNEL feasibility on QEMU -M virt (kernel base: v6.14).
# Merge on top of `make ARCH=riscv tinyconfig` via scripts/kconfig/merge_config.sh.
#
# Goal: smallest MMU kernel that boots XIP from pflash0 with an XIP cramfs
# rootfs on pflash1, console on the virt machine's 8250.

# --- Architecture: rv32, UP, XIP ---
CONFIG_ARCH_RV32I=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
# CONFIG_SMP is not set
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x20000000
# RAM view starts 2M above QEMU virt's DRAM base: OpenSBI fw_jump resides at
# 0x80000000 (PMP-protected) and the XIP kernel places .data at PHYS_RAM_BASE.
CONFIG_PHYS_RAM_BASE=0x80200000
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
# Match a lowest-common-denominator ISA (bao1x is rv32imac_zicsr_zifencei_zkn)
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZBS=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n

# --- Core minimalism ---
CONFIG_EXPERT=y
CONFIG_SLUB_TINY=y
CONFIG_MODULES=n
CONFIG_BLOCK=y
CONFIG_NET=n
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_CPU_IDLE=n

# --- Boot / console visibility ---
# Built-in cmdline: QEMU's -append only works with -kernel, which we don't use
# (the kernel boots XIP from pflash via OpenSBI fw_jump).
CONFIG_CMDLINE="console=ttyS0 earlycon mtdparts=20000000.flash:32M(kernel)ro,32M(rootfs)ro rootfstype=cramfs root=mtd:rootfs ro"
CONFIG_CMDLINE_FORCE=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- QEMU virt hardware (phase-1 only; bao1x uses none of these) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# --- Rootfs: XIP cramfs on memory-mapped NOR (pflash1) ---
CONFIG_MTD=y
CONFIG_MTD_CFI=y
CONFIG_MTD_CFI_INTELEXT=y
CONFIG_MTD_CFI_AMDSTD=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
# QEMU maps both pflash banks under one DT node -> one MTD; split by cmdline
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_BLOCK_RO=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_BLOCKDEV=y
CONFIG_CRAMFS_MTD=y
