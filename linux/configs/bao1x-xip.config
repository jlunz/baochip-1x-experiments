# Baochip-1x XIP kernel fragment (kernel base: v6.14 + linux/patches/v6.14).
# Merge on top of `make ARCH=riscv tinyconfig`.
#
# Phase-3 scope: boot to shell in Renode with ZERO custom kernel drivers —
# console is the SBI DBCN hvc (bao1x-sbi routes it to uDMA UART2), timer is
# the stock RISCV_TIMER via SBI set_timer + rdtime emulation, rootfs is XIP
# cramfs on mtd-rom straight out of RRAM. Native drivers come next.

# --- Architecture: rv32, UP, XIP at the bao1x RRAM/SRAM addresses ---
CONFIG_ARCH_RV32I=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=y
# CONFIG_SMP is not set
CONFIG_SPARSEMEM_MANUAL=y
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x60000000
CONFIG_XIP_KERNEL_ENTRY_OFFSET=0x70000
CONFIG_PHYS_RAM_BASE=0x61000000
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZBS=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n

# --- Core minimalism (2MiB RAM; see docs/04-bringup-log.md 2026-07-15) ---
CONFIG_EXPERT=y
CONFIG_SLUB_TINY=y
CONFIG_MODULES=n
CONFIG_BLOCK=n
CONFIG_NET=n
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_CPU_IDLE=n
CONFIG_LOG_BUF_SHIFT=12
CONFIG_THREAD_SIZE_ORDER=0
CONFIG_SCHED_STACK_END_CHECK=y
# KALLSYMS is free under XIP (rodata stays in flash) and pays for itself
# during bring-up.
CONFIG_KALLSYMS=y

# --- Boot / console ---
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y
# Native bao1x drivers: ext-irq array + IRQARRAY banks, uDMA UART console,
# DUART earlycon.
CONFIG_BAO1X_INTC=y
CONFIG_SERIAL_BAO1X=y
CONFIG_SERIAL_BAO1X_CONSOLE=y
# IOX pinctrl + GPIO; userspace access via /dev/gpiochip0 (v2 ioctls only)
CONFIG_PINCTRL=y
CONFIG_PINCTRL_BAO1X=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
# CONFIG_GPIO_CDEV_V1 is not set
# uDMA I2C (polled) + /dev/i2c-0; perclk comes from a fixed-clock DT node
CONFIG_COMMON_CLK=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BAO1X=y
# uDMA SPI (polled) + JEDEC NOR support for external flash
CONFIG_SPI=y
CONFIG_SPI_BAO1X=y
CONFIG_MTD_SPI_NOR=y

# --- Rootfs: XIP cramfs on the RRAM (native driver: mapped reads + point,
# writes through the RRC line buffer for the "data" partition) ---
CONFIG_MTD=y
CONFIG_MTD_BAO1X_RRAM=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MISC_FILESYSTEMS=y
# Writable /data on the RRAM data partition. No zlib: its deflate
# workspace alone (~270K) OOM-panics a 2MiB system at boot; rtime
# compression is nearly free.
CONFIG_JFFS2_FS=y
# CONFIG_JFFS2_FS_WRITEBUFFER is not set
CONFIG_JFFS2_COMPRESSION_OPTIONS=y
# CONFIG_JFFS2_ZLIB is not set
CONFIG_JFFS2_RTIME=y
CONFIG_CRAMFS=y
CONFIG_CRAMFS_MTD=y
