# Dabao hardware bring-up: make the board and the debug probe usable from an
# unprivileged user (and from inside a toolbox, where the host's dialout gid
# does not map and the nodes show up as nobody:nobody).
#
# Without this, /dev/ttyACM0 reverts to 0660 root:dialout every time the board
# resets and re-enumerates -- which happens on every single boot attempt.
#
# Install on the HOST (not in the toolbox -- udev runs on the host):
#   sudo cp setup/99-baochip.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# Baochip-1x: boot1 USB CDC console (+ the BAOCHIP mass-storage volume)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6196", MODE="0666"

# Raspberry Pi Debug Probe (CMSIS-DAP): if01 is the UART wired to PB14/PB13
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000c", MODE="0666"
